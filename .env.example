APP_NAME="Hevy Analytics"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

# Set to your load balancer / proxy IPs, or "*" behind a trusted one.
# Without this, every IP-based rate limit sees the proxy instead of the client.
TRUSTED_PROXIES=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=hevy_analytics
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Hevy API
HEVY_BASE_URL=https://api.hevyapp.com

# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=2000

# Hard caps on AI spend. Counted in attempts, not stored analyses.
AI_MONTHLY_LIMIT_PER_USER=30
AI_MONTHLY_LIMIT_GLOBAL=5000

# FitnessVolt strength standards (free, CC BY 4.0)
FITNESSVOLT_BASE_URL=https://fitnessvolt.com/wp-json/rpe-training/v1
FITNESSVOLT_ENABLED=true

# OpenPowerlifting bulk CSV (fallback source)
OPL_CSV_URL=https://openpowerlifting.gitlab.io/opl-csv/files/openpowerlifting-latest.zip

# AI analysis (optional).
#
# This is the operator's key — the "included with your subscription" path, which
# is rationed by AI_MONTHLY_LIMIT_PER_USER. Athletes can instead add their own
# key in Settings, which bypasses the allowance entirely because they are
# spending their own account.
#
# Leave AI_API_KEY empty to ship without an included allowance; the AI page then
# tells athletes to add their own key.
AI_PROVIDER=deepseek
AI_API_KEY=
AI_MODEL=deepseek-v4-flash
AI_MONTHLY_LIMIT_PER_USER=30
AI_MONTHLY_LIMIT_GLOBAL=5000

# Allow athletes to point the app at a loopback address (Ollama, LM Studio).
# MUST stay false on any deployment serving people other than you: the server
# makes an authenticated outbound request to whatever endpoint a user supplies.
AI_ALLOW_LOCAL_PROVIDERS=false

# Billing (Paddle). Leave PADDLE_PRICE_ID empty to run without subscriptions —
# everyone then stays on the trial/free tiers and the billing page says so.
#
# PADDLE_WEBHOOK_SECRET is NOT optional once billing is on: Cashier only
# verifies webhook signatures when it is set, and an unverified webhook lets
# anyone grant themselves a subscription. The app refuses to boot in production
# without it.
PADDLE_SANDBOX=true
PADDLE_SELLER_ID=
PADDLE_CLIENT_SIDE_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID=

# Cashier formats every Paddle amount with this and defaults to USD, so a euro
# price renders with a dollar sign until you set it.
CASHIER_CURRENCY=EUR
CASHIER_CURRENCY_LOCALE=pt_PT

BILLING_DISPLAY_PRICE="€8"
BILLING_TRIAL_DAYS=14

# On login, queue an incremental Hevy sync when the last one is older than
# this many hours. 0 disables login syncs.
HEVY_AUTO_SYNC_HOURS=6

# Only for deployments with no mail provider: marks new accounts as verified
# at registration, because the verification email would go nowhere. Turn OFF
# as soon as real mail is configured.
AUTO_VERIFY_EMAIL=false

# Operator accounts, created once by `php artisan app:bootstrap-accounts`
# (runs automatically on container boot). Accounts that already exist are
# never touched. Set these in the HOST's dashboard — not in a committed file.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# Where progress photos live. 'local' for development; 'r2' in production,
# because a container host wipes the local disk on every deploy and these are
# the one kind of file nobody can re-create.
PHOTO_DISK=local

# Cloudflare R2 (S3-compatible object storage). Free tier: 10 GB, and — the
# reason it is the right choice here — no egress charges, which matters because
# every photo is streamed through the app rather than served from a public URL.
# Create at dash.cloudflare.com → R2 → Create bucket, then an API token.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=

# Resend (transactional email). Free tier: 3 000 emails/month, 100/day.
# Set MAIL_MAILER=resend once RESEND_API_KEY is filled in, and turn
# AUTO_VERIFY_EMAIL back off — verification links can reach people now.
RESEND_API_KEY=
